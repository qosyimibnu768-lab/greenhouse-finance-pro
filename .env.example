# Salin file ini menjadi .env (untuk pemakaian lokal) lalu isi nilainya.
# Untuk versi online (Vercel), isi variabel yang sama di:
# Vercel → project → Settings → Environment Variables → Redeploy.

# ===== Opsi 1 (utama): Supabase Postgres langsung =====
# Ambil dari Supabase → tombol Connect → Connection String → Pooler (Transaction mode).
# Format: postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
SUPABASE_DB_URL=

# ===== Opsi 1b: Supabase REST (butuh kunci API) =====
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# Nama tabel & baris (opsional, biasanya tidak perlu diubah):
# SUPABASE_TABLE=gfp_database
# GFP_ROW_ID=main

# ===== Opsi 2: Upstash Redis — gratis =====
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ===== Opsi 3: Vercel Blob =====
# BLOB_READ_WRITE_TOKEN=

# Paksa pilih mode penyimpanan (opsional): supabase | upstash | blob | local
# GFP_STORAGE=supabase
